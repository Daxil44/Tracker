@page "/settings"

<PageTitle>Settings · Tracker</PageTitle>

<div class="settings-page">
    <header class="page-header">
        <p class="eyebrow"><Icon Name="sliders" Size="16" /> Settings</p>
        <h1>Make it yours</h1>
        <p class="lede">Add your name, pick your bottle, set your daily goal and choose when to be reminded.</p>
    </header>

    <GoalSettings />

    <ReminderSettings />

    <p class="settings-note">
        Your goal is a personal target you choose, not medical advice.
        Settings are saved in this browser, so everyone using Tracker on their own device keeps their own.
    </p>
</div>
