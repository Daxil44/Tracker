@* Small inline stroke-icon set so the app needs no icon dependency. *@
<svg class="icon @Class" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="@StrokeWidth" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case "droplet":
            <path d="M12 2.8c3.6 4.1 6.2 7.5 6.2 10.9a6.2 6.2 0 0 1-12.4 0c0-3.4 2.6-6.8 6.2-10.9z" />
            break;
        case "logo":
            @* Tracker mark: two progress rings *@
            <path d="M12 3.5a8.5 8.5 0 1 1-8.5 8.5" />
            <path d="M12 7.5a4.5 4.5 0 0 1 0 9" />
            break;
        case "dashboard":
            <rect x="3.5" y="3.5" width="7" height="9" rx="2" />
            <rect x="13.5" y="3.5" width="7" height="5" rx="2" />
            <rect x="13.5" y="11.5" width="7" height="9" rx="2" />
            <rect x="3.5" y="15.5" width="7" height="5" rx="2" />
            break;
        case "sun":
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4" />
            break;
        case "moon":
            <path d="M20 14.6A8 8 0 0 1 9.4 4a8 8 0 1 0 10.6 10.6z" />
            break;
        case "bottle":
            <path d="M10 2.5h4M10.5 2.5v3L8 9v10.5a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2V9l-2.5-3.5v-3" />
            <path d="M8 13h8" />
            break;
        case "half":
            <path d="M10 2.5h4M10.5 2.5v3L8 9v10.5a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2V9l-2.5-3.5v-3" />
            <path d="M8 15.5h8" />
            break;
        case "glass":
            <path d="M5.5 3.5h13l-1.6 16.2a2 2 0 0 1-2 1.8H9.1a2 2 0 0 1-2-1.8z" />
            <path d="M6.4 10h11.2" />
            break;
        case "undo":
            <path d="M9 14 4 9l5-5" />
            <path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11" />
            break;
        case "plus":
            <path d="M12 5v14M5 12h14" />
            break;
        case "trash":
            <path d="M4 7h16M9.5 7V4.5h5V7M6.5 7l1 13h9l1-13" />
            break;
        case "check":
            <path d="m5 12.5 4.5 4.5L19 7.5" />
            break;
        case "target":
            <circle cx="12" cy="12" r="8.5" />
            <circle cx="12" cy="12" r="4.5" />
            <circle cx="12" cy="12" r="1" />
            break;
        case "clock":
            <circle cx="12" cy="12" r="8.5" />
            <path d="M12 7.5V12l3 2" />
            break;
        case "sliders":
            <path d="M4 7h9M17 7h3M4 17h3M11 17h9" />
            <circle cx="15" cy="7" r="2" />
            <circle cx="9" cy="17" r="2" />
            break;
        case "minus":
            <path d="M5 12h14" />
            break;
        case "edit":
            <path d="M4 20h4L19 9a2.8 2.8 0 0 0-4-4L4 16z" />
            <path d="m13.5 6.5 4 4" />
            break;
        case "bell":
            <path d="M6 9a6 6 0 0 1 12 0c0 6 2.5 7.5 2.5 7.5h-17S6 15 6 9z" />
            <path d="M10 20a2.2 2.2 0 0 0 4 0" />
            break;
        case "close":
            <path d="M6 6l12 12M18 6 6 18" />
            break;
        case "pause":
            <path d="M9 5v14M15 5v14" />
            break;
        case "play":
            <path d="M8 5.5v13l10.5-6.5z" />
            break;
        case "alert":
            <path d="M12 3.5 21.5 20h-19z" />
            <path d="M12 10v4M12 17v.01" />
            break;
        case "message":
            <path d="M5 4.5h14a1.5 1.5 0 0 1 1.5 1.5v9.5A1.5 1.5 0 0 1 19 17h-8l-4.5 3.5V17H5a1.5 1.5 0 0 1-1.5-1.5V6A1.5 1.5 0 0 1 5 4.5z" />
            <path d="M8 9h8M8 12.5h5" />
            break;
        case "send":
            <path d="M20.5 3.5 10 14" />
            <path d="M20.5 3.5 14 20.5l-4-6.5-6.5-4z" />
            break;
        case "sparkle":
            <path d="M12 3.5 13.9 9 19.5 11l-5.6 2L12 18.5 10.1 13 4.5 11l5.6-2z" />
            <path d="M19 3v3M17.5 4.5h3" />
            break;
        case "shield":
            <path d="M12 3 19.5 6v5.5c0 4.6-3.2 8.2-7.5 9.5-4.3-1.3-7.5-4.9-7.5-9.5V6z" />
            <path d="m9 12 2.2 2.2L15.5 10" />
            break;
        case "download":
            <path d="M12 4v11M7.5 10.5 12 15l4.5-4.5" />
            <path d="M4.5 18.5v1a1 1 0 0 0 1 1h13a1 1 0 0 0 1-1v-1" />
            break;
        case "upload":
            <path d="M12 15V4M7.5 8.5 12 4l4.5 4.5" />
            <path d="M4.5 18.5v1a1 1 0 0 0 1 1h13a1 1 0 0 0 1-1v-1" />
            break;
        case "calendar":
            <rect x="3.5" y="5" width="17" height="15.5" rx="3" />
            <path d="M3.5 10h17M8 3v4M16 3v4" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 20;
    [Parameter] public string StrokeWidth { get; set; } = "2";
    [Parameter] public string? Class { get; set; }
}
