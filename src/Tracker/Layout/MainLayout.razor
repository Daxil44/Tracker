@inherits LayoutComponentBase
@inject PreferencesService Preferences
@inject WaterTrackingService Tracking
@inject ThemeService Theme
@inject ReminderService Reminders

@if (!_ready)
{
    <div class="boot" role="status" aria-live="polite">
        <div class="boot-drop" aria-hidden="true"></div>
        <p>Loading your data…</p>
    </div>
}
else
{
    <div class="app-shell">
        <NavRail />
        <main class="app-main">
            @Body
        </main>
    </div>
}

@code {
    private bool _ready;

    protected override async Task OnInitializedAsync()
    {
        await Preferences.InitializeAsync();
        await Tracking.InitializeAsync();
        await Theme.ApplyAsync(Preferences.Current.Theme);
        await Reminders.InitializeAsync();
        _ready = true;
    }
}
